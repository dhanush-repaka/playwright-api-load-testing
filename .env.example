# ---------------------------------------------------------------------------
# Target API
# ---------------------------------------------------------------------------
# Environment file: local | local-oauth2 | qa | staging  (config/environments/<name>.json)
TEST_ENV=local

# The API URI you were given. Overrides baseUrl from the environment JSON.
# BASE_URL=https://api.yourcompany.com
# REQUEST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication  (NEVER commit real values - .env is git-ignored)
# ---------------------------------------------------------------------------
# none | bearer | oauth2 - overrides "auth.type" from the environment JSON
# AUTH_TYPE=bearer

# Bearer token you were given (with or without the "Bearer " prefix)
API_BEARER_TOKEN=local-dev-token-6f1d2c9e

# Optional extra tokens for role-based scenarios, referenced by name in features:
#   Given requests are authenticated with the bearer token from "API_BEARER_TOKEN_READONLY"
API_BEARER_TOKEN_READONLY=local-readonly-token-3b7a91f0

# OAuth2 client-credentials (used when auth.type = "oauth2", e.g. TEST_ENV=local-oauth2)
OAUTH_CLIENT_ID=load-test-client
OAUTH_CLIENT_SECRET=local-dev-secret-8c2e4a17
# OAUTH_TOKEN_URL=https://login.yourcompany.com/oauth2/token

# ---------------------------------------------------------------------------
# Load scaling & logging
# ---------------------------------------------------------------------------
# LOAD_PROFILE=smoke
# VU_MULTIPLIER=1
# DURATION_MULTIPLIER=1
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Mock server (local only) - simulates a corporate API gateway
# ---------------------------------------------------------------------------
MOCK_PORT=3100
MOCK_BASE_LATENCY_MS=20
MOCK_LATENCY_JITTER_MS=30
MOCK_ERROR_RATE=0
MOCK_REQUIRE_AUTH=true
MOCK_STATIC_TOKENS=local-dev-token-6f1d2c9e,local-readonly-token-3b7a91f0
MOCK_OAUTH_CLIENT_ID=load-test-client
MOCK_OAUTH_CLIENT_SECRET=local-dev-secret-8c2e4a17
MOCK_OAUTH_TOKEN_TTL_SECONDS=3600
